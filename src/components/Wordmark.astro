---
interface Props {
  size?: "lg" | "md";
  href?: string;
}
const { size = "lg", href } = Astro.props;
const sizeClass = size === "lg"
  ? "text-[80px] leading-none tracking-[0.05em]"
  : "text-2xl leading-none tracking-[0.05em]";

const Tag = href ? "a" : "span";
---

<Tag
  {...(href ? { href } : {})}
  class={`font-normal ${sizeClass} ${href ? "hover:opacity-70 transition-opacity" : ""}`}
>
  SNLP
</Tag>
