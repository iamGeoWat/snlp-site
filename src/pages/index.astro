---
import Layout from "../components/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
import ProductCard from "../components/ProductCard.astro";
---

<Layout title="SNLP">
  <section>
    <Wordmark size="lg" />
    <p class="mt-6 text-xl opacity-70">
      Solar and Lunar Powered. A small studio for thoughtful apps.
    </p>
  </section>

  <section class="mt-24">
    <h2 class="text-sm uppercase tracking-[0.15em] opacity-60 mb-6">Apps</h2>
    <ProductCard
      href="/tofu-records"
      name="Tofu Records"
      zhName="淘封面"
      description="Browse your Apple Music library iPod-style. Save album art and animated covers."
    />
  </section>
</Layout>
