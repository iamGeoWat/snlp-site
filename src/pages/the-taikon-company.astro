---
import Layout from "../components/Layout.astro";
---

<Layout
  title="the taikon company"
  description="A rocketry and orbital-mechanics sandbox. Build rockets, fly them to orbit and the Moon, and bring them home."
>
  <section>
    <h1 class="text-5xl font-medium leading-tight">
      the taikon company
      <span class="block mt-2 text-2xl opacity-60">太空有限公司</span>
    </h1>
    <p class="mt-6 text-xl opacity-80 leading-relaxed">
      A rocketry and orbital-mechanics sandbox. Build a rocket, fly it to orbit and on to the Moon,
      and bring the crew home.
    </p>
  </section>

  <section class="mt-16">
    <h2 class="text-sm uppercase tracking-[0.15em] opacity-60 mb-6">Inside</h2>
    <ul class="space-y-4 text-lg leading-relaxed">
      <li><strong>Build.</strong> Assemble rockets, landers and stations from parts in the assembly building.</li>
      <li><strong>Fly real orbits.</strong> Orbital mechanics, maneuver nodes and a map that shows where you are going.</li>
      <li><strong>Come home.</strong> Re-entry heating, parachutes and splashdown.</li>
      <li><strong>Walk on the Moon.</strong> Crew out of the hatch, flags, samples and a rover.</li>
      <li><strong>Privacy first.</strong> No ads, no tracking, no account, no analytics. Your saves stay on your device.</li>
    </ul>
  </section>

  <section id="support" class="mt-16">
    <h2 class="text-sm uppercase tracking-[0.15em] opacity-60 mb-6">Support</h2>
    <p class="text-lg leading-relaxed">
      Questions, bug reports or feedback:
      <a href="mailto:myyyyywang@gmail.com" class="underline">myyyyywang@gmail.com</a>.
    </p>
    <p class="mt-4 text-lg leading-relaxed opacity-80">
      For a bug, please include your device model, its iOS, iPadOS or macOS version, and the game version shown
      on the title screen. A screenshot helps.
    </p>
    <p class="mt-4 text-lg leading-relaxed opacity-80">
      Privacy: <a href="/privacy" class="underline">snlp.dev/privacy</a>.
    </p>
  </section>
</Layout>
